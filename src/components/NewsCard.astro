---
import { formatDate, type Source } from '../data/press';

interface Props {
  item: Source;
}
const { item } = Astro.props;
const kindLabel = { article: 'Article', photos: 'Photo story', video: 'Video', record: 'Record' }[item.kind];
---

<a
  href={item.url}
  rel="noopener"
  target="_blank"
  class="group flex h-full flex-col rounded-3xl bg-white p-7 ring-1 ring-brand-100 transition-[translate,box-shadow,background-color] duration-500 hover:-translate-y-1 hover:shadow-[0_24px_60px_-28px_rgb(10_37_64/0.35)] hover:ring-brand-200"
>
  <div class="flex items-center justify-between gap-3 text-xs font-semibold uppercase tracking-[0.14em]">
    <span class="text-brand-600">{item.outlet}</span>
    <span class="rounded-full bg-brand-50 px-2.5 py-1 text-[0.68rem] text-brand-700">{kindLabel}</span>
  </div>
  <h3 class="mt-5 text-[1.35rem] leading-snug text-ink transition-colors group-hover:text-brand-700">{item.title}</h3>
  <p class="mt-3 text-[0.95rem] leading-relaxed text-ink-soft">{item.summary}</p>
  <div class="mt-auto flex items-center justify-between pt-6 text-sm">
    <time datetime={item.date} class="text-ink-soft">{formatDate(item.date)}</time>
    <span class="inline-flex items-center gap-1.5 font-semibold text-brand-700">
      Read
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5"><path d="M7 17 17 7M8 7h9v9"></path></svg>
      <span class="sr-only">(opens in a new tab)</span>
    </span>
  </div>
</a>
