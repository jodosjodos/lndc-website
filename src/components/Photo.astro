---
import { Picture } from 'astro:assets';
import type { Photo as PhotoData } from '../data/photos';

interface Props {
  photo: PhotoData;
  sizes?: string;
  widths?: number[];
  class?: string;
  imgClass?: string;
  loading?: 'lazy' | 'eager';
  priority?: boolean;
  /** Show the caption and credit under the image. */
  caption?: boolean;
}

const {
  photo,
  sizes = '(min-width: 1024px) 50vw, 100vw',
  widths = [480, 800, 1200, 1600, 2048],
  class: className = '',
  imgClass = '',
  loading = 'lazy',
  priority = false,
  caption = false,
} = Astro.props;
const maxW = photo.src.width;
const usable = widths.filter((w) => w <= maxW);
---

<figure class={className}>
  <Picture
    src={photo.src}
    alt={photo.alt}
    formats={['avif', 'webp']}
    widths={usable.length ? usable : [maxW]}
    sizes={sizes}
    loading={priority ? 'eager' : loading}
    fetchpriority={priority ? 'high' : 'auto'}
    class={`h-full w-full object-cover ${imgClass}`}
    style={photo.focus ? `object-position: ${photo.focus}` : undefined}
  />
  {
    caption && (
      <figcaption class="mt-3 text-sm text-ink-soft">
        {photo.caption}.{' '}
        <span class="text-ink-soft/80">
          Photo:{' '}
          <a href={photo.credit.url} class="underline underline-offset-2 hover:text-brand-700" rel="noopener" target="_blank">
            {photo.credit.name}
          </a>
        </span>
      </figcaption>
    )
  }
</figure>
