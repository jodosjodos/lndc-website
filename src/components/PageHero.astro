---
import { Picture } from 'astro:assets';
import type { Photo } from '../data/photos';

interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
  photo: Photo;
}
const { eyebrow, title, intro, photo } = Astro.props;
---

<section data-hero class="relative isolate flex min-h-[78svh] items-end overflow-hidden bg-brand-950 text-white md:min-h-[72svh]">
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute inset-0 overflow-hidden">
      <Picture
        src={photo.src}
        alt=""
        formats={['avif', 'webp']}
        widths={[768, 1280, 1920, 2560].filter((w) => w <= photo.src.width)}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        class="page-hero-img h-full w-full object-cover"
        style={photo.focus ? `object-position: ${photo.focus}` : undefined}
      />
    </div>
    <div class="absolute inset-0 bg-gradient-to-t from-brand-950 via-brand-950/60 to-brand-950/30"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-brand-950/75 to-transparent"></div>
  </div>
  <svg class="pointer-events-none absolute -right-[10vw] top-[10vh] -z-10 h-[70vh] w-auto text-brand-300/20" viewBox="0 0 100 88" aria-hidden="true">
    <path d="M50 2 L98 86 L2 86 Z" fill="none" stroke="currentColor" stroke-width="0.6"></path>
  </svg>

  <div class="container-x pb-16 pt-36 md:pb-20">
    <div class="max-w-3xl">
      <p class="eyebrow on-dark" data-reveal>{eyebrow}</p>
      <h1 class="mt-5 text-[clamp(2.6rem,6vw,5rem)] font-[520] leading-[1.03] text-white" data-split>{title}</h1>
      {intro && <p class="mt-6 max-w-2xl text-lg leading-relaxed text-brand-50/90 md:text-xl" data-reveal data-reveal-delay="0.1">{intro}</p>}
    </div>
    <p class="mt-10 text-xs text-white/60" data-reveal data-reveal-delay="0.25">{photo.caption} · Photo: {photo.credit.name}</p>
  </div>
</section>

<style>
  .page-hero-img { animation: var(--animate-kenburns); }
</style>
