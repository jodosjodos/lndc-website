---
import { values } from '../data/site';
---

<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4" data-stagger>
  <div class="relative flex flex-col justify-between overflow-hidden rounded-3xl bg-brand-950 p-7 text-white">
    <svg class="absolute -bottom-8 -right-8 h-40 w-40 text-brand-500/30" viewBox="0 0 100 88" aria-hidden="true">
      <path d="M50 2 L98 86 L2 86 Z" fill="none" stroke="currentColor" stroke-width="5"></path>
    </svg>
    <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand-300">Tugomba twese</p>
    <div class="mt-10">
      <p class="font-display text-3xl leading-tight">“We must all…”</p>
      <p class="mt-3 text-sm leading-relaxed text-brand-100/75">Seven commitments, written in Kinyarwanda on a sign on campus, that shape life at LNDC.</p>
    </div>
  </div>
  {
    values.map((v, i) => (
      <article class="group relative flex flex-col rounded-3xl bg-brand-50 p-7 ring-1 ring-brand-100 transition-[translate,box-shadow,background-color] duration-500 hover:-translate-y-1 hover:bg-white hover:shadow-[0_24px_60px_-28px_rgb(10_37_64/0.35)]">
        <span class="font-display text-sm text-brand-500">{String(i + 1).padStart(2, '0')}</span>
        <h3 class="mt-6 text-[1.6rem] text-ink" lang="rw">{v.rw}</h3>
        <p class="mt-1 font-semibold text-brand-700">{v.en}</p>
        <p class="mt-3 text-sm leading-relaxed text-ink-soft">{v.note}</p>
      </article>
    ))
  }
</div>
