---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import { albums, allPhotos, photos, type Album } from '../data/photos';

const order: Album[] = ['learning', 'celebration', 'culture', 'remembrance'];
const items = await Promise.all(
  order.flatMap((album) =>
    allPhotos
      .filter((p) => p.album === album)
      .map(async (p) => ({ ...p, large: (await getImage({ src: p.src, width: Math.min(2048, p.src.width), format: 'webp' })).src })),
  ),
);
const credits = [...new Map(allPhotos.map((p) => [p.credit.url, p.credit])).values()];
---

<Base title="Gallery" description="Photographs of school life at Lycée Notre-Dame de Cîteaux in Kigali." overlayHeader>
  <PageHero
    eyebrow="Gallery"
    title="Moments at LNDC"
    intro="Learning, celebrating, performing and remembering: a look inside our school."
    photo={photos.greatHall}
  />

  <section class="container-x py-20 md:py-28">
    <div class="flex flex-wrap gap-2" role="group" aria-label="Filter photos" data-reveal>
      <button type="button" class="chip is-active" data-filter="all" aria-pressed="true">All</button>
      {order.map((a) => <button type="button" class="chip" data-filter={a} aria-pressed="false">{albums[a]}</button>)}
    </div>

    <ul class="mt-10 columns-1 gap-4 sm:columns-2 lg:columns-3 [&>li]:mb-4" id="gallery">
      {
        items.map((p, i) => (
          <li class="break-inside-avoid" data-album={p.album}>
            <button
              type="button"
              class="group relative block w-full overflow-hidden rounded-2xl text-left"
              data-index={i}
              data-large={p.large}
              data-alt={p.alt}
              data-caption={p.caption}
              data-credit={p.credit.name}
              data-credit-url={p.credit.url}
              aria-label={`Open photo: ${p.caption}`}
            >
              <Photo photo={{ ...p, focus: undefined }} imgClass="!h-auto transition-transform duration-700 group-hover:scale-[1.04]" sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw" widths={[480, 800, 1200]} />
              <span class="pointer-events-none absolute inset-x-0 bottom-0 bg-gradient-to-t from-brand-950/85 to-transparent p-4 pt-12 text-sm text-white opacity-0 transition-opacity duration-300 group-hover:opacity-100 group-focus-visible:opacity-100">
                {p.caption}
              </span>
            </button>
          </li>
        ))
      }
    </ul>
  </section>

  <section id="credits" class="bg-mist py-16">
    <div class="container-x">
      <h2 class="text-3xl text-ink">Photo credits</h2>
      <p class="mt-3 max-w-2xl text-ink-soft">With thanks to the photographers and organisations whose pictures of our school appear on this site.</p>
      <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {
          credits.map((c) => (
            <li class="rounded-2xl bg-white p-5 ring-1 ring-brand-100">
              <a href={c.url} rel="noopener" target="_blank" class="font-semibold text-brand-700 underline-offset-2 hover:underline">{c.name}</a>
              <p class="mt-1 text-sm text-ink-soft">{c.license}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <dialog id="lightbox" class="lightbox" aria-label="Photo viewer" data-lenis-prevent>
    <div class="flex h-full w-full flex-col">
      <div class="flex items-center justify-between gap-4 px-4 py-3 text-white md:px-6">
        <p class="text-sm text-white/70" data-lb-count></p>
        <button type="button" class="lb-btn" data-lb-close aria-label="Close">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
        </button>
      </div>
      <div class="relative flex min-h-0 flex-1 items-center justify-center px-4 md:px-20">
        <button type="button" class="lb-btn absolute left-2 md:left-5" data-lb-prev aria-label="Previous photo">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6" /></svg>
        </button>
        <img data-lb-img alt="" class="max-h-full max-w-full rounded-xl object-contain shadow-2xl" />
        <button type="button" class="lb-btn absolute right-2 md:right-5" data-lb-next aria-label="Next photo">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6" /></svg>
        </button>
      </div>
      <div class="px-4 pb-6 pt-4 text-center text-white md:px-6">
        <p class="font-display text-lg" data-lb-caption></p>
        <p class="mt-1 text-sm text-white/65">Photo: <a data-lb-credit href={items[0].credit.url} class="underline underline-offset-2 hover:text-white" rel="noopener" target="_blank">{items[0].credit.name}</a></p>
      </div>
    </div>
  </dialog>
</Base>

<style>
  .chip {
    border-radius: 999px;
    padding: 0.55rem 1.1rem;
    font-weight: 600;
    font-size: 0.92rem;
    color: var(--color-brand-800);
    box-shadow: inset 0 0 0 1.5px var(--color-brand-200);
    transition: background-color 0.2s, color 0.2s;
  }
  .chip:hover { background: var(--color-brand-50); }
  .chip.is-active { background: var(--color-brand-600); color: #fff; box-shadow: none; }
  #gallery li.is-hidden { display: none; }
  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(10 37 64 / 0.96);
  }
  .lightbox::backdrop { background: transparent; }
  .lightbox[open] { animation: lb-in 0.3s ease; }
  @keyframes lb-in { from { opacity: 0; } }
  .lb-btn {
    display: grid;
    place-items: center;
    width: 2.9rem;
    height: 2.9rem;
    border-radius: 999px;
    color: #fff;
    background: rgb(255 255 255 / 0.1);
    transition: background-color 0.2s;
    z-index: 1;
  }
  .lb-btn:hover { background: rgb(255 255 255 / 0.22); }
</style>

<script>
  const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const tiles = [...document.querySelectorAll<HTMLLIElement>('#gallery li')];
  chips.forEach((chip) =>
    chip.addEventListener('click', () => {
      const f = chip.dataset.filter;
      chips.forEach((c) => {
        c.classList.toggle('is-active', c === chip);
        c.setAttribute('aria-pressed', String(c === chip));
      });
      tiles.forEach((t) => t.classList.toggle('is-hidden', f !== 'all' && t.dataset.album !== f));
    }),
  );

  const dialog = document.getElementById('lightbox') as HTMLDialogElement;
  const img = dialog.querySelector<HTMLImageElement>('[data-lb-img]')!;
  const cap = dialog.querySelector('[data-lb-caption]')!;
  const credit = dialog.querySelector<HTMLAnchorElement>('[data-lb-credit]')!;
  const count = dialog.querySelector('[data-lb-count]')!;
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('#gallery [data-index]')];
  let current = 0;
  let opener: HTMLElement | null = null;

  // Arrows step through the photos currently visible under the active filter.
  const visible = () => buttons.filter((b) => !b.closest('li')!.classList.contains('is-hidden'));
  const show = (btn: HTMLButtonElement) => {
    const list = visible();
    current = list.indexOf(btn);
    const d = btn.dataset;
    img.src = d.large!;
    img.alt = d.alt!;
    cap.textContent = d.caption!;
    credit.textContent = d.credit!;
    credit.href = d.creditUrl!;
    count.textContent = `${current + 1} / ${list.length}`;
  };
  const step = (dir: number) => {
    const list = visible();
    show(list[(current + dir + list.length) % list.length]);
  };

  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      opener = b;
      show(b);
      dialog.showModal();
      document.documentElement.style.overflow = 'hidden';
    }),
  );
  dialog.querySelector('[data-lb-prev]')!.addEventListener('click', () => step(-1));
  dialog.querySelector('[data-lb-next]')!.addEventListener('click', () => step(1));
  dialog.querySelector('[data-lb-close]')!.addEventListener('click', () => dialog.close());
  dialog.addEventListener('close', () => {
    document.documentElement.style.overflow = '';
    opener?.focus();
  });
  dialog.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') step(-1);
    if (e.key === 'ArrowRight') step(1);
  });
  let touchX = 0;
  dialog.addEventListener('touchstart', (e) => (touchX = e.touches[0].clientX), { passive: true });
  dialog.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - touchX;
    if (Math.abs(dx) > 50) step(dx < 0 ? 1 : -1);
  });
</script>
