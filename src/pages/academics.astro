---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import SectionHeading from '../components/SectionHeading.astro';
import StatBand from '../components/StatBand.astro';
import CTA from '../components/CTA.astro';
import { photos } from '../data/photos';
import { combinations } from '../data/site';
import { byId, formatDate, references } from '../data/press';

const recognitions = ['orator-2026', 'nesa-results-2025', 'best-student-2024', 'best-students-2023', 'cmc-2025', 'money-makeover-2024'].map(byId);
---

<Base
  title="Academics"
  description="O-Level and A-Level at Lycée Notre-Dame de Cîteaux: the MCB, PCB, PCM and MPG combinations, results and recognitions."
  overlayHeader
>
  <PageHero
    eyebrow="Academics"
    title="Learning that opens doors"
    intro="From Senior One to Senior Six, LNDC follows Rwanda's national curriculum and prepares every girl for the national examinations set by NESA."
    photo={photos.classroomFocus}
  />

  <!-- Levels -->
  <section class="container-x py-24 md:py-32">
    <SectionHeading
      eyebrow="Two levels"
      title="A clear path from S1 to S6"
      intro="Students build a strong general foundation at Ordinary Level, then specialise at Advanced Level in one of four science combinations."
      class="mb-14"
    />
    <div class="grid gap-5 lg:grid-cols-2" data-stagger>
      <article class="relative overflow-hidden rounded-[1.75rem] bg-brand-50 p-8 ring-1 ring-brand-100 md:p-10">
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-brand-600">Ordinary Level</p>
        <h3 class="mt-3 text-4xl text-ink">Senior 1 – Senior 3</h3>
        <p class="mt-4 max-w-lg text-lg leading-relaxed text-ink-soft">
          Three years across the full national curriculum, closing with the O-Level national examination. In 2024/25 every one of our 172 candidates
          passed.
        </p>
        <ul class="mt-8 space-y-3 text-ink">
          <li class="flex gap-3"><span class="mt-2 h-2 w-2 shrink-0 rotate-45 bg-brand-500"></span>Placement into S1 by NESA after the Primary Leaving Examination</li>
          <li class="flex gap-3"><span class="mt-2 h-2 w-2 shrink-0 rotate-45 bg-brand-500"></span>A national-best record: Rwanda's top O-Level student in 2023/24</li>
          <li class="flex gap-3"><span class="mt-2 h-2 w-2 shrink-0 rotate-45 bg-brand-500"></span>Preparation for the S4 placement and A-Level choice</li>
        </ul>
      </article>
      <article class="relative overflow-hidden rounded-[1.75rem] bg-brand-950 p-8 text-white md:p-10">
        <svg class="absolute -right-10 -top-10 h-56 w-56 text-brand-500/20" viewBox="0 0 100 88" aria-hidden="true">
          <path d="M50 2 L98 86 L2 86 Z" fill="none" stroke="currentColor" stroke-width="4"></path>
        </svg>
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-brand-300">Advanced Level</p>
        <h3 class="mt-3 text-4xl text-white">Senior 4 – Senior 6</h3>
        <p class="mt-4 max-w-lg text-lg leading-relaxed text-brand-100/85">
          Three years of focused study in a chosen combination, leading to the A-Level national examination and on to higher education.
        </p>
        <ul class="mt-8 space-y-3">
          <li class="flex gap-3"><span class="mt-2 h-2 w-2 shrink-0 rotate-45 bg-brand-400"></span>Placement into S4 by NESA after the O-Level examination</li>
          <li class="flex gap-3"><span class="mt-2 h-2 w-2 shrink-0 rotate-45 bg-brand-400"></span>Four science combinations accredited by NESA</li>
          <li class="flex gap-3"><span class="mt-2 h-2 w-2 shrink-0 rotate-45 bg-brand-400"></span>MCB, PCB, PCM and MPG, all built on mathematics and the sciences</li>
        </ul>
      </article>
    </div>
  </section>

  <!-- Combinations -->
  <section class="bg-mist py-24 md:py-32">
    <div class="container-x">
      <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <SectionHeading eyebrow="A-Level combinations" title="Four ways to pursue science" />
        <a href={references.nesaList} class="text-sm text-ink-soft underline underline-offset-2 hover:text-brand-700" rel="noopener" target="_blank" data-reveal>
          Source: NESA list of accredited schools
        </a>
      </div>
      <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-4" data-stagger>
        {
          combinations.map((c) => (
            <article class="group flex flex-col rounded-3xl bg-white p-7 ring-1 ring-brand-100 transition-[translate,box-shadow] duration-500 hover:-translate-y-1 hover:shadow-[0_24px_60px_-28px_rgb(10_37_64/0.35)]">
              <p class="font-display text-5xl font-[480] tracking-tight text-brand-600">{c.code}</p>
              <h3 class="mt-5 text-xl leading-snug text-ink">{c.name}</h3>
              <p class="mt-auto pt-6 text-sm leading-relaxed text-ink-soft">
                <span class="font-semibold text-ink">A path towards</span> {c.path.charAt(0).toLowerCase() + c.path.slice(1)}.
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <StatBand />

  <!-- Learning spaces -->
  <section class="container-x py-24 md:py-32">
    <div class="grid items-center gap-14 lg:grid-cols-2 lg:gap-20">
      <div>
        <SectionHeading
          eyebrow="Where we learn"
          title="The Great Hall and our classrooms"
          intro="The Great Hall, the “Grande Salle” stencilled on its chairs, is the heart of school life: assemblies, visiting speakers, cultural performances and celebrations all happen here."
        />
        <p class="mt-5 text-lg leading-relaxed text-ink-soft" data-reveal>
          In the classroom, girls learn side by side at shared desks, taking notes, asking questions and supporting each other in the spirit of
          <span lang="rw" class="font-semibold text-ink">gufashanya</span>, helping one another.
        </p>
      </div>
      <div class="grid grid-cols-2 gap-4" data-stagger>
        <Photo photo={photos.greatHall} class="col-span-2 [&_img]:aspect-[16/10] [&_img]:rounded-3xl" sizes="(min-width: 1024px) 45vw, 100vw" />
        <Photo photo={photos.classRow} class="[&_img]:aspect-square [&_img]:rounded-3xl" sizes="(min-width: 1024px) 22vw, 50vw" />
        <Photo photo={photos.classPair} class="[&_img]:aspect-square [&_img]:rounded-3xl" sizes="(min-width: 1024px) 22vw, 50vw" />
      </div>
    </div>
  </section>

  <!-- Recognitions -->
  <section class="bg-mist py-24 md:py-32">
    <div class="container-x">
      <SectionHeading eyebrow="Recognition" title="Results and achievements" intro="Each item links to its original source." class="mb-14" />
      <ol class="divide-y divide-brand-100 overflow-hidden rounded-3xl bg-white ring-1 ring-brand-100" data-stagger>
        {
          recognitions.map((r) => (
            <li>
              <a href={r.url} rel="noopener" target="_blank" class="group grid gap-2 px-6 py-6 transition-colors hover:bg-brand-50 md:grid-cols-[10rem_1fr_auto] md:items-center md:gap-8 md:px-8">
                <time datetime={r.date} class="text-sm font-semibold text-brand-600">{formatDate(r.date)}</time>
                <span>
                  <span class="block text-lg font-semibold text-ink">{r.summary}</span>
                  <span class="mt-1 block text-sm text-ink-soft">{r.outlet}</span>
                </span>
                <svg class="hidden h-5 w-5 text-brand-500 transition-transform group-hover:translate-x-1 md:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"></path></svg>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <CTA />
</Base>
